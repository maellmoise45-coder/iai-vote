# ============================================================
#  Digital-Elect - fichiers a NE PAS versionner
# ============================================================

# Configuration locale (contient des secrets) : ne jamais committer
.env
api/config.local.php

# Dependances / artefacts
node_modules/
vendor/

# Fichiers systeme / editeurs
.DS_Store
Thumbs.db
*.log
*.tmp
.idea/
.vscode/

# Serveur PostgreSQL portable (si present par erreur dans le dossier)
pgsql/

# Sauvegardes locales (donnees sensibles, jamais versionnees)
sauvegardes/*
!sauvegardes/.htaccess

# Identifiants du miroir local (production -> PostgreSQL local)
outils/miroir.local.php
outils/*.log
outils/*.log.old
outils/*.lock

# Compteurs de limitation de requetes (recrees automatiquement)
api/cache/*
!api/cache/.htaccess
