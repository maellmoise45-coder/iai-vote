# ============================================================
#  Variables d'environnement - Digital-Elect
#  Copiez ce fichier en .env et adaptez les valeurs.
# ============================================================

# --- Base de donnees PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=iai_vote
DB_USER=postgres
DB_PASS=postgres

# --- Secret applicatif (jetons + hash anonyme des votes) ---
# IMPORTANT en production : changez cette valeur !
# Generation : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=changez-moi-en-production

# --- Jeton d'installation (api/install.php) ---
# Obligatoire : sans ce jeton, install.php repond 403.
# A supprimer une fois la base initialisee.
INSTALL_TOKEN=changez-moi-jeton-temporaire

# --- Origine CORS (facultatif) ---
# A renseigner uniquement si le frontend et l'API sont sur des
# domaines differents. Vide = meme origine uniquement.
# APP_ORIGIN=https://vote.exemple.cm

# --- (Render) ---
# Render fournit automatiquement DATABASE_URL ; si elle est
# presente, elle a la priorite sur DB_HOST/DB_PORT/DB_NAME.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
