# ============================================================
#  Variables d'environnement - Digital-Elect
#  Copiez ce fichier en .env et adaptez les valeurs.
# ============================================================

# --- Base de donnees PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=iai_vote
DB_USER=postgres
DB_PASS=postgres

# --- Secret applicatif (jetons + hash anonyme des votes) ---
# IMPORTANT en production : changez cette valeur !
APP_SECRET=changez-moi-en-production

# --- (Render) ---
# Render fournit automatiquement DATABASE_URL ; si elle est
# presente, elle a la priorite sur DB_HOST/DB_PORT/DB_NAME.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
